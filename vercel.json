{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/search.js": {
      "maxDuration": 60
    },
    "api/search-v2.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/search",
      "destination": "/api/search-v2"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
